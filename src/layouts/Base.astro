---
const { title, desc, lang = 'en', i18n } = Astro.props;
const t = i18n;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={desc}>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="alternate icon" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" href="/assets/favicon-180.png">
<link rel="stylesheet" href="/style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href={lang === 'en' ? '/' : `/${lang}/`}>
      <span class="brand-mark">◆</span> Apps
    </a>
    <nav class="nav-links">
      <a href={lang === 'en' ? '/#install' : `/${lang}/#install`}>{i18n.install_nav}</a>
      <a href="https://github.com/hieuspaceos" target="_blank" rel="noopener">GitHub</a>
      <a class="donate" href="https://github.com/sponsors/hieuspaceos" target="_blank" rel="noopener">♥<span class="donate-txt"> Sponsor</span></a>
      <div class="lang-menu">
        <button class="lang-btn" type="button" aria-label="Language" aria-haspopup="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg></button>
        <div class="lang-drop" role="menu">
          <a href="/">English</a>
          <a href="/vi/">Tiếng Việt</a>
          <a href="/ja/">日本語</a>
          <a href="/ko/">한국어</a>
          <a href="/zh/">中文</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div class="container footer-inner">
    <p>{t.footer}</p>
  </div>
</footer>

<script>
  const lm = document.querySelector('.lang-menu');
  if (lm) {
    const btn = lm.querySelector('.lang-btn');
    btn.addEventListener('click', (e) => { e.stopPropagation(); lm.classList.toggle('open'); });
    document.addEventListener('click', (e) => { if (!lm.contains(e.target)) lm.classList.remove('open'); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') lm.classList.remove('open'); });
  }
</script>

</body>
</html>
