---
const { title, desc, lang = 'en', i18n } = Astro.props;
const t = i18n;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={desc}>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="alternate icon" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" href="/assets/favicon-180.png">
<link rel="stylesheet" href="/style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href={lang === 'vi' ? '/vi/' : '/'}>
      <span class="brand-mark">◆</span> suite<span class="brand-dot">.</span><span class="brand-sub">hieuspace</span>
    </a>
    <nav class="nav-links">
      <a href={lang === 'vi' ? '/vi/#apps' : '/#apps'}>{lang === 'vi' ? 'Apps' : 'Apps'}</a>
      <a href={lang === 'vi' ? '/vi/#install' : '/#install'}>{lang === 'vi' ? 'Cài đặt' : 'Install'}</a>
      <a href="https://github.com/hieuspaceos" target="_blank" rel="noopener">GitHub</a>
      <a class="donate" href="https://github.com/sponsors/hieuspaceos" target="_blank" rel="noopener">♥ Sponsor</a>
      <a class="lang-switch" href={t.lang_href}><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>{t.lang_link}</a>
    </nav>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div class="container footer-inner">
    <p>{t.footer}</p>
  </div>
</footer>

</body>
</html>
