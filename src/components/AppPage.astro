---
import { apps } from '../data/apps.js';
const { app, t, lang } = Astro.props;
const others = apps.filter((a) => a.id !== app.id);
const appHref = (id) => `${lang === 'en' ? '' : '/' + lang}/apps/${id}`;
---

<section class="app-hero container">
  <img class="big-icon" src={app.icon} alt={`${app.name} icon`} width="108" height="108">
  <p class="replaces">{t.replaces} {app.replaces[lang] ?? app.replaces.en}</p>
  <h1>{app.name}</h1>
  <p class="tagline">{app.tagline[lang] ?? app.tagline.en}</p>
  <div class="hero-cta">
    <a class="btn btn-primary" href={`${app.repo}/releases/latest`} target="_blank" rel="noopener">{t.download}</a>
    <a class="btn btn-ghost" href={app.repo} target="_blank" rel="noopener">{t.view_src}</a>
  </div>

  <div class="meta-row">
    <div class="meta-item"><span>{t.meta_platform === 'Mac' ? t.meta_platform_lbl : t.meta_platform}</span><b>Mac</b></div>
    <div class="meta-item"><span>{t.meta_version}</span><b>{app.version}</b></div>
    <div class="meta-item"><span>macOS</span><b>14+</b></div>
    <div class="meta-item"><span>{t.meta_size}</span><b>{app.size}</b></div>
    <div class="meta-item"><span>RAM</span><b>{app.ram}</b></div>
    <div class="meta-item"><span>{t.meta_perm_lbl}</span><b>{app.permission[lang] ?? app.permission.en}</b></div>
  </div>

  <div class="hero-shot">
    <video src={`/assets/${app.id}-demo.mp4`} poster={app.hero} controls muted playsinline preload="metadata"></video>
  </div>
</section>
<section class="container">
  <p class="app-desc">{app.desc[lang] ?? app.desc.en}</p>
  <div class="feature-grid">
    {(app.features[lang] ?? app.features.en).map((f, i) => (
      <div class="feature-block">
        <div class="fi">{['⌘','✎','⧉','⛶','⚙'][i % 5]}</div>
        <b>{f.split('·')[0].split('—')[0].trim()}</b>
        <p>{f}</p>
      </div>
    ))}
  </div>
  <p class="perm">{t.perm_note} <b>{app.permission[lang] ?? app.permission.en}</b> — {lang === 'vi'
    ? 'macOS sẽ hỏi khi mở lần đầu; cấp trong System Settings → Privacy & Security.'
    : 'macOS will ask on first launch; grant under System Settings → Privacy & Security.'}</p>
</section>

<section class="container vs-wrap">
  <h2 class="section-title">{t.vs_title}{app.rival.name}</h2>
  <div class="vs-table">
    <div class="vs-row vs-head">
      <span></span><span class="vs-ours">{app.name}</span><span>{app.rival.name}</span>
    </div>
    <div class="vs-row">
      <span>{t.vs_size}</span><span class="vs-ours">{app.size}</span><span>{app.rival.size}</span>
    </div>
    <div class="vs-row">
      <span>{t.vs_ram} (idle)</span><span class="vs-ours">{app.ram}</span><span>{app.rival.ram}</span>
    </div>
    <div class="vs-row">
      <span>{t.vs_ram_use}</span><span class="vs-ours">{app.ram_use}</span><span>—</span>
    </div>
    <div class="vs-row">
      <span>{t.vs_price}</span><span class="vs-ours">Free · Open source</span><span>{app.rival.price}</span>
    </div>
  </div>
</section>

<section class="more">
  <div class="container">
    <h2 class="section-title">{t.more_apps}</h2>
    <div class="more-grid">
      {others.map((o) => (
        <a class="more-tile" href={appHref(o.id)}>
          <img src={o.icon} alt={`${o.name} icon`}>
          <div><b>{o.name}</b><small>{o.tagline[lang] ?? o.tagline.en}</small></div>
        </a>
      ))}
      <a class="more-tile" href="https://github.com/hieuspaceos" target="_blank" rel="noopener">
        <div><b>GitHub</b><small>hieuspaceos</small></div>
      </a>
    </div>
  </div>
</section>
