---
import { apps } from '../data/apps.js';
const { t, lang } = Astro.props;
const appHref = (id) => `${lang === 'en' ? '' : '/' + lang}/apps/${id}`;
---

<section class="hero">
  <div class="hero-glow"></div>
  <div class="container">
    <p class="kicker">{t.kicker}</p>
    <h1>{t.h1a} <span class="grad">{t.h1b}</span>{t.h1c}</h1>
    <p class="lede">{t.lede}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#apps">{t.cta_apps}</a>
      <a class="btn btn-ghost" href="https://github.com/hieuspaceos" target="_blank" rel="noopener">{t.cta_gh}</a>
    </div>
    <p class="req">{t.req}</p>
  </div>
</section>

<section id="apps" class="apps container">
  <h2 class="section-title">{t.apps_title}</h2>
  <p class="section-sub">{t.apps_sub}</p>
  <div class="apps-bar">
    <div class="apps-search-wrap">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input class="apps-search" type="search" placeholder={t.search_ph} aria-label={t.search_ph}>
    </div>
    <div class="apps-chips">
      <button class="chip active" data-cat="all">{t.cat_all}</button>
      <button class="chip" data-cat="media">{t.cat_media}</button>
      <button class="chip" data-cat="window">{t.cat_window}</button>
      <button class="chip" data-cat="productivity">{t.cat_productivity}</button>
      <button class="chip" data-cat="system">{t.cat_system}</button>
    </div>
  </div>
  <div class="apps-grid" id="appsGrid">
    {apps.map((a) => (
      <article class="app-tile" data-cat={a.cat} data-search={`${a.name} ${a.replaces.en} ${a.tagline[lang] ?? a.tagline.en} ${a.tagline.en}`.toLowerCase()}>
        <a class="app-tile-media" href={appHref(a.id)}>
          <img src={a.hero} alt={`${a.name} screenshot`} loading="lazy">
        </a>
        <div class="app-tile-body">
          <img class="app-tile-icon" src={a.icon} alt={`${a.name} icon`} width="56" height="56">
          <div>
            <p class="replaces">{t.replaces} {a.replaces[lang] ?? a.replaces.en}</p>
            <h3><a href={appHref(a.id)}>{a.name}</a></h3>
            <p class="tagline">{a.tagline[lang] ?? a.tagline.en}</p>
          </div>
        </div>
        <div class="tile-cta">
          <a class="btn btn-ghost" href={appHref(a.id)}>{t.learn_more}</a>
          <a class="gh-link" href={a.repo} target="_blank" rel="noopener" aria-label="GitHub">
            <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <a class="btn btn-primary" href={`${a.repo}/releases/latest`} target="_blank" rel="noopener">{t.download}</a>
        </div>
      </article>
    ))}
    <article class="app-tile app-tile--soon" data-cat="__soon">
      <div class="app-tile-body">
        <div>
          <h3 class="dim">{t.soon_title}</h3>
          <p class="tagline dim">{t.soon_desc}</p>
        </div>
      </div>
    </article>
  </div>
</section>

<section id="install" class="install">
  <div class="container">
    <h2 class="section-title">{t.install_title}</h2>
    <p class="section-sub">{t.install_sub}</p>
    <ol class="steps">
      {t.steps.map((s, i) => (
        <li>
          <span class="step-n">{i + 1}</span><div class="txt-wrap"><b>{s[0]}</b><span class="txt">{s[1]}</span></div>
        </li>
      ))}
    </ol>
    <div class="install-brew">
      <p class="brew-or">{t.install_brew_or}</p>
      <code class="brew-block">brew tap hieuspaceos/suite && brew trust hieuspaceos/suite<br>brew install --cask swiftshot clipspot swishlite flipswitch</code>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const grid = document.getElementById('appsGrid');
    if (!grid) return;
    const input = document.querySelector('.apps-search');
    const chips = [...document.querySelectorAll('.apps-chips .chip')];
    const tiles = [...grid.querySelectorAll('.app-tile:not(.app-tile--soon)')];
    let cat = 'all', q = '';
    const apply = () => {
      tiles.forEach(t => {
        const okCat = cat === 'all' || t.dataset.cat === cat;
        const okQ = !q || t.dataset.search.includes(q);
        t.style.display = (okCat && okQ) ? '' : 'none';
      });
      document.querySelector('.app-tile--soon').style.display =
        cat === 'all' && !q ? '' : 'none';
    };
    input?.addEventListener('input', () => { q = input.value.trim().toLowerCase(); apply(); });
    chips.forEach(c => c.addEventListener('click', () => {
      chips.forEach(x => x.classList.remove('active'));
      c.classList.add('active');
      cat = c.dataset.cat; apply();
    }));
  })();
</script>
