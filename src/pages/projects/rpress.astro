---
import Base from '../../layouts/Base.astro';
import { t as i18n } from '../../data/apps.js';
import { projects } from '../../data/projects.js';
const lang = 'en';
const t = i18n[lang];
const p = projects.find(x => x.id === 'rpress');
---

<Base lang={lang} i18n={t} title="RPress — WordPress-parity CMS in one Rust binary">

<style>
.pr-hero{position:relative;padding:64px 0 56px;text-align:center;overflow:hidden;min-height:78vh;display:flex;align-items:center}
.pr-hero .container{width:100%}
.pr-hero::before{content:"";position:absolute;inset:-40% -10% auto;height:520px;
  background:radial-gradient(closest-side,rgba(255,106,0,.16),transparent 70%);pointer-events:none}
.pr-kicker{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1px solid var(--border);
  border-radius:999px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);background:var(--bg2)}
.pr-kicker b{color:#ff6a00;font-weight:600}
.pr-hero h1{font-size:clamp(48px,7vw,88px);font-weight:800;letter-spacing:-.045em;line-height:.95;margin:26px 0 14px;
  background:linear-gradient(180deg,#fff 30%,rgba(255,255,255,.55));-webkit-background-clip:text;background-clip:text;color:transparent}
.pr-hero .lede{max-width:640px;margin:0 auto;color:var(--muted);font-size:clamp(16px,1.8vw,19px);line-height:1.55}
.pr-cta{display:flex;gap:12px;justify-content:center;margin-top:32px;flex-wrap:wrap}
.pr-btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:10px;font-weight:600;font-size:15px;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease}
.pr-btn:hover{transform:translateY(-1px)}
.pr-btn--primary{background:#ff6a00;color:#0b0b0f;box-shadow:0 10px 30px rgba(255,106,0,.25)}
.pr-btn--ghost{border:1px solid var(--border);color:var(--fg);background:transparent}
.pr-meta{display:flex;flex-wrap:wrap;gap:0;justify-content:center;margin-top:44px}
.pr-meta .m{padding:12px 26px;border-right:1px solid var(--border);text-align:left}
.pr-meta .m:last-child{border-right:0}
.pr-meta .m span{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.pr-meta .m b{font-size:15px}

.pr-term{max-width:760px;margin:56px auto 0;border:1px solid var(--border);border-radius:14px;background:#0d0f14;
  box-shadow:0 30px 80px rgba(0,0,0,.45);overflow:hidden;text-align:left}
.pr-term-bar{display:flex;gap:6px;padding:12px 14px;border-bottom:1px solid var(--border)}
.pr-term-bar i{width:10px;height:10px;border-radius:50%;background:#3a3f4a}
.pr-term-bar i:nth-child(1){background:#ff5f57}.pr-term-bar i:nth-child(2){background:#febc2e}.pr-term-bar i:nth-child(3){background:#28c840}
.pr-term pre{margin:0;padding:20px 22px;font-size:13px;line-height:1.7;color:#c9d1d9;overflow:auto}
.pr-term .c{color:#6a737d}.pr-term .g{color:#7ee787}.pr-term .o{color:#ffa657}.pr-term .p{color:#79c0ff}

.pr-sec{padding:56px 0;border-top:1px solid var(--border);overflow-x:clip}
.pr-sec--who{border-top:0;padding-top:32px}
.pr-sec h2{font-size:clamp(26px,3.4vw,36px);font-weight:800;letter-spacing:-.03em;text-align:center;margin:0 0 12px}
.pr-sec .sub{text-align:center;color:var(--muted);max-width:620px;margin:0 auto 44px;font-size:16px}

.pr-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;max-width:1080px;margin:0 auto}
.pr-card{border:1px solid var(--border);border-radius:14px;padding:24px;background:var(--bg2);transition:border-color .2s,transform .2s}
.pr-card:hover{border-color:#ff6a0066;transform:translateY(-2px)}
.pr-card .n{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#ff6a00;font-weight:700}
.pr-card b{display:block;font-size:17px;margin:8px 0 8px;letter-spacing:-.01em}
.pr-card p{margin:0;color:var(--muted);font-size:14px;line-height:1.6}
.pr-card code{background:rgba(255,255,255,.06);padding:1px 6px;border-radius:5px;font-size:12px}

.pr-tbl{max-width:920px;margin:0 auto;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--bg2)}
.pr-tbl .r{display:grid;grid-template-columns:1.1fr 1.2fr 1fr;gap:16px;padding:15px 22px;border-top:1px solid var(--border);font-size:14px;align-items:center}
.pr-tbl .r:first-child{border-top:0;background:rgba(255,255,255,.04);font-weight:700}
.pr-tbl .r>span:first-child{color:var(--muted);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.pr-tbl .r .ours{color:#7ee787;font-weight:600}
.pr-tbl .r .ours::before{content:"✓ ";color:#7ee787;font-weight:700}
.pr-tbl .r .ours--warn{color:#ffa657}
.pr-tbl .r .ours--warn::before{content:"◐ ";color:#ffa657}
.pr-tbl .r .bad{color:var(--muted)}
.pr-tbl .r .bad::before{content:"✗ ";color:#f85149;font-weight:700;opacity:.85}
.pr-tbl .r .bad--ok{color:var(--muted)}
.pr-tbl .r .bad--ok::before{content:"— ";color:var(--muted)}
.pr-tbl--4 .r{grid-template-columns:1fr 1.25fr 1.15fr 1.15fr;font-size:13px}

.pr-arch{max-width:820px;margin:0 auto;border:1px solid var(--border);border-radius:14px;background:#0d0f14;padding:26px}
.pr-arch pre{margin:0;font-size:13px;line-height:1.7;color:#c9d1d9;overflow:auto}

.pr-callout{max-width:820px;margin:44px auto 0;border-left:3px solid #ff6a00;background:var(--bg2);
  border-radius:0 12px 12px 0;padding:18px 22px;color:var(--muted);font-size:14px;line-height:1.65}
.pr-callout b{color:var(--fg)}

.pr-foot{padding:72px 0 96px;text-align:center}
.pr-foot .big{font-size:clamp(24px,3.4vw,34px);font-weight:800;letter-spacing:-.03em}
.pr-foot code{display:inline-block;margin-top:18px;background:#0d0f14;border:1px solid var(--border);
  border-radius:10px;padding:14px 22px;font-size:14px;color:#7ee787}
.pr-hero h1 .grad{background:linear-gradient(90deg,#ff6a00,#ffa657);-webkit-background-clip:text;background-clip:text;color:transparent}
.rr{background:linear-gradient(135deg,#ff6a00 20%,#ffa657 90%);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 22px rgba(255,106,0,.45));margin-right:2px}
.rmark{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;margin-right:8px;border-radius:6px;
  background:linear-gradient(135deg,#ff6a00,#ffa657);color:#0a0b0e;font-weight:800;font-size:15px;
  box-shadow:0 0 18px rgba(255,106,0,.55);vertical-align:middle}
.pr-vs .r{opacity:0;transform:translateX(-18px);transition:opacity .4s cubic-bezier(.2,.8,.2,1),transform .4s cubic-bezier(.2,.8,.2,1)}
.pr-vs .r.on{opacity:1;transform:none}
.pr-vs .r:nth-child(odd){transform:translateX(18px)}
.pr-vs .r:nth-child(odd).on{transform:none}

.pr-vs{max-width:none;width:100%;border-radius:18px;background:linear-gradient(160deg,#0d0f14,#0a0b0e);border-color:rgba(255,255,255,.13)}
.pr-vs .r{padding:18px 30px;font-size:15px}
.pr-vs .r>span{opacity:0;transform:translateX(-14px);transition:opacity .45s cubic-bezier(.2,.8,.2,1),transform .45s cubic-bezier(.2,.8,.2,1)}
.pr-vs .r>span:nth-child(2){transform:translateX(-22px)}
.pr-vs .r>span:nth-child(3){transform:translateX(22px)}
.pr-vs .r>span:nth-child(4){transform:translateX(34px)}
.pr-vs .r.on>span{opacity:1;transform:none}
.pr-vs .r>span:first-child{transform:none}
.pr-vs .r.on>span:first-child{opacity:1}
.pr-vs .r{opacity:1;transform:none}
.pr-vs .r:nth-child(odd){transform:none}
.pr-vs .r.on{background:rgba(255,255,255,.015)}
.pr-vs .r:first-child{opacity:1}
.pr-vs .r:first-child>span{opacity:1;transform:none}
.vs-facts{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;max-width:1320px;margin:0 auto;width:100%}
.vs-fact{border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:24px 22px;background:rgba(255,255,255,.02);opacity:0;transform:translateY(14px);transition:opacity .5s,transform .5s}
.vs-beat.on .vs-fact{opacity:1;transform:none}
.vs-beat.on .vs-fact:nth-child(1){transition-delay:.1s}.vs-beat.on .vs-fact:nth-child(2){transition-delay:.25s}
.vs-beat.on .vs-fact:nth-child(3){transition-delay:.4s}.vs-beat.on .vs-fact:nth-child(4){transition-delay:.55s}
.vs-fact.rp{border-color:#7ee787;background:rgba(126,231,135,.05)}
.vs-num{display:block;font:800 58px/0.95 'Space Grotesk';letter-spacing:-.04em;color:#f85149;font-variant-numeric:tabular-nums;text-shadow:0 0 34px rgba(248,81,73,.35)}
.vs-num.rp{color:#7ee787;text-shadow:0 0 34px rgba(126,231,135,.4)}
.vs-fact-lbl{display:block;font-size:12.5px;color:#c9d1d9;margin-top:12px;line-height:1.5}
.vs-fact-lbl em{color:#8b949e;font-style:normal;display:block;margin-top:4px;font-size:11.5px}
.vs-fact-src{display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#6a737d;margin-top:10px}
.vs-punch{text-align:center;font:700 22px 'Space Grotesk';letter-spacing:-.01em;color:#ffa657;margin-top:34px;opacity:0;transform:translateY(8px);transition:opacity .5s,transform .5s}
.vs-beat.on .vs-punch{opacity:1;transform:none;transition-delay:.9s}
.vs-fact-lbl b{color:#ffa657;font-weight:700}
@media (max-width:1100px){.vs-facts{grid-template-columns:repeat(3,1fr)}}@media (max-width:760px){.vs-facts{grid-template-columns:repeat(2,1fr)}}
html,body{overflow-x:clip}
</style>
<style>
.pr-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;text-align:left}
.pr-hero-copy h1{margin:22px 0 12px}
.pr-hero-copy .lede{margin:0 0 26px}
.pr-hero-copy .pr-cta{justify-content:flex-start}
.pr-hero-copy .pr-meta{justify-content:flex-start;margin-top:34px}
.pr-hero-copy .pr-meta .m{border-left:1px solid var(--border);padding-left:16px}
.pr-anim{position:relative;height:480px}
.pr-anim-frame{position:relative;width:100%;height:100%;border:1px solid var(--border);border-radius:18px;background:linear-gradient(160deg,#0d0f14,#0a0b0e);overflow:hidden;box-shadow:0 40px 90px rgba(0,0,0,.55)}
.a-scene{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:34px;opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease}
.a-scene.on{opacity:1;transform:none}
.a-cap{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#ff6a00;margin-bottom:22px}
.a-migrate .a-cap{margin-top:18px;margin-bottom:0}
.a-term{width:100%;max-width:400px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:#0d0f14;overflow:hidden}
.a-term-bar{display:flex;gap:6px;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.07)}
.a-term-bar i{width:9px;height:9px;border-radius:50%;background:#ff5f57}.a-term-bar i:nth-child(2){background:#febc2e}.a-term-bar i:nth-child(3){background:#28c840}
.a-term pre{margin:0;padding:16px 18px;font:500 13.5px/1.85 'IBM Plex Mono',ui-monospace,monospace;color:#c9d1d9;white-space:pre-wrap}
.a-term .g{color:#7ee787}
.a-term .o{display:block;opacity:0;color:#8b949e;transition:opacity .3s}
.a-term .o.show{opacity:1}
.a-term .cmd-type{color:#ffa657;font-weight:600}
.a-term .caret{display:inline-block;width:8px;height:15px;background:#7ee787;vertical-align:middle;animation:a-blink 1s steps(1) infinite}
@keyframes a-blink{50%{opacity:0}}
.a-row{display:flex;flex-direction:column;gap:8px;width:100%;max-width:420px;margin-bottom:26px}
.a-lbl{font:600 13px 'IBM Plex Mono',ui-monospace,monospace;color:#f85149}
.a-lbl.ours{color:#7ee787}
.a-bars{display:flex;gap:4px;align-items:center}
.a-bars i{height:20px;border-radius:5px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.2,.9,.2,1)}
.a-scene.on .a-bars i{transform:scaleX(1)}
.a-bars .b1{width:34px}.a-bars .b2{width:60px}
.a-bars.wp i{background:rgba(248,81,73,.12);border-color:rgba(248,81,73,.4)}
.a-bars.wp .w1{width:56px;transition-delay:.1s}.a-bars.wp .w2{width:80px;transition-delay:.22s}
.a-bars.wp .w3{width:96px;transition-delay:.34s}.a-bars.wp .w4{width:120px;transition-delay:.46s}
.a-ms{font:700 15px 'Space Grotesk',sans-serif;color:#f85149;margin-left:10px;white-space:nowrap}
.a-ms.ours{color:#7ee787}
.a-cells{display:flex;gap:14px;width:100%;max-width:420px}
.a-cell{flex:1;border:1px solid rgba(255,255,255,.13);border-radius:12px;padding:18px 16px;background:rgba(255,255,255,.02)}
.a-cell.hot{border-color:#ff6a00;background:rgba(255,106,0,.08);box-shadow:0 0 30px rgba(255,106,0,.15)}
.a-cell span{display:block;font:600 11px 'IBM Plex Mono',ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:#8b949e}
.a-cell b{display:block;font:700 16px 'Space Grotesk',sans-serif;color:#fff;margin-top:6px}
.a-note{margin-top:20px;font:400 12.5px 'IBM Plex Mono',ui-monospace,monospace;color:#6a737d}
.a-dots{display:flex;gap:8px;justify-content:center;margin-top:16px}
.a-dots .d{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.18);transition:background .3s,transform .3s}
.a-dots .d.on{background:#ff6a00;transform:scale(1.3)}
@media (max-width:980px){
  .pr-hero-grid{grid-template-columns:1fr;text-align:center}
  .pr-hero-copy .pr-cta,.pr-hero-copy .pr-meta{justify-content:center}
  .pr-hero-copy .pr-meta .m{border-left:none;border-top:1px solid var(--border);padding:10px 14px 0}
  .pr-anim{height:380px}
}
</style>
<style>
.pr-how{border:1px solid var(--border);border-radius:18px;background:linear-gradient(160deg,#0d0f14,#0a0b0e);padding:34px 30px;margin-top:30px;font-family:'IBM Plex Mono',ui-monospace,monospace}
.h-lane{margin-bottom:34px}
.h-tag{font-size:11px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:14px}
.h-tag.pub{color:#ff6a00}.h-tag.srv{color:#7ee787}
.h-flow{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.h-node{border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:13px 18px;font-size:14px;color:#c9d1d9;background:rgba(255,255,255,.02);
  opacity:0;transform:translateY(8px);transition:opacity .45s,transform .45s,border-color .45s,box-shadow .45s}
.h-node.on{opacity:1;transform:none}
.h-node.lit{border-color:#ff6a00;box-shadow:0 0 22px rgba(255,106,0,.3);color:#fff}
.h-node.hit{border-color:#7ee787;color:#7ee787}
.h-node.hit.lit{box-shadow:0 0 22px rgba(126,231,135,.3)}
.h-node.hot{border-color:#ff6a00;color:#ffa657}
.h-edge{width:38px;height:2px;background:linear-gradient(90deg,transparent,var(--border),transparent);position:relative;flex:none;opacity:0;transition:opacity .3s}
.h-edge::after{content:"";position:absolute;right:-2px;top:-4px;border:5px solid transparent;border-left-color:#8b949e}
.h-edge.on{opacity:1}
.h-wp{margin-top:16px;display:flex;align-items:center;gap:14px;opacity:0;transition:opacity .5s}
.h-wp.on{opacity:1}
.h-wp-lbl{font-size:12px;color:#f85149}
.h-wp-bars{display:flex;gap:4px;align-items:center}
.h-wp-bars i{height:14px;border-radius:4px;background:rgba(248,81,73,.12);border:1px solid rgba(248,81,73,.4);transform:scaleX(0);transform-origin:left;transition:transform .3s}
.h-wp.on .h-wp-bars i{transform:scaleX(1)}
.h-wp-bars i:nth-child(1){width:40px;transition-delay:.1s}.h-wp-bars i:nth-child(2){width:56px;transition-delay:.2s}
.h-wp-bars i:nth-child(3){width:70px;transition-delay:.3s}.h-wp-bars i:nth-child(4){width:80px;transition-delay:.4s}
.h-wp-bars i:nth-child(5){width:92px;transition-delay:.5s}.h-wp-bars i:nth-child(6){width:64px;transition-delay:.6s}
.h-wp-bars b{font:700 14px 'Space Grotesk';color:#f85149;margin-left:8px;white-space:nowrap}
.h-disk{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;border-top:1px dashed var(--border);padding-top:22px}
.h-cell{border:1px solid rgba(255,255,255,.13);border-radius:10px;padding:14px 16px;font-size:13px;color:#8b949e;opacity:0;transform:translateY(8px);transition:opacity .45s,transform .45s}
.h-cell.on{opacity:1;transform:none}
.h-cell span{display:block;font-weight:600;color:#fff;margin-bottom:4px;font-size:14px}
.h-cell.hot{border-color:#ff6a00;background:rgba(255,106,0,.06)}
.h-cell.hot span{color:#ffa657}
@media (max-width:760px){.h-disk{grid-template-columns:1fr}.h-edge{width:24px}}
</style>
<style>
.h-sec{border-top:1px dashed var(--border);padding-top:26px;margin-top:6px}
.h-tag.atk{color:#f85149}
.h-arch{display:flex;flex-direction:column;gap:10px}
.h-arch-row{display:grid;grid-template-columns:190px 1fr 260px;gap:16px;align-items:center;border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:13px 16px;background:rgba(255,255,255,.015);
  opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s}
.h-arch-row.on{opacity:1;transform:none}
.a-what{font-weight:600;color:#ffa657;font-size:12.5px}
.a-how{font-size:12.5px;color:#c9d1d9;line-height:1.55}
.a-how code{color:#79c0ff;font-size:11.5px}
.a-how b{color:#fff}
.a-kills{font-size:11px;color:#f85149;line-height:1.5;border-left:2px solid rgba(248,81,73,.4);padding-left:12px}
.h-atk-note{margin-top:18px;font-size:13px;color:#8b949e;opacity:0;transition:opacity .5s;line-height:1.6}
.h-atk-note.on{opacity:1}
.h-atk-note b{color:#fff}.h-atk-note i{color:#ffa657;font-style:normal}
@media (max-width:860px){.h-arch-row{grid-template-columns:1fr;gap:8px}.a-kills{border-left:none;padding-left:0}}
</style>
<style>
.vs-stage{position:relative;margin-top:28px;margin-left:calc(50% - 50vw);width:100vw;max-width:100vw;border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  background:
    radial-gradient(60% 90% at 18% 10%,rgba(255,106,0,.07),transparent 60%),
    radial-gradient(50% 80% at 85% 90%,rgba(126,231,135,.05),transparent 60%),
    linear-gradient(160deg,#0d0f14,#07080b);
  min-height:520px;overflow:hidden;font-family:'IBM Plex Mono',ui-monospace,monospace}
.vs-beat{inset:0;padding:56px max(40px,calc(50vw - 640px)) 72px}
.vs-cap{font-size:14px;letter-spacing:.3em}
.vs-track,.vs-mill,.vs-ram{max-width:1180px}
.vs-attack{max-width:1280px}
.vs-lane{grid-template-columns:200px 1fr 190px}
.vs-name{font-size:15px}
.vs-time{font-size:13px}
.vs-run{height:40px}
.vs-runner{width:18px;height:18px}
.vs-runner::after{content:"";position:absolute;right:14px;top:50%;transform:translateY(-50%);width:120px;height:2px;
  background:linear-gradient(90deg,rgba(126,231,135,.6),transparent)}
.vs-runner i{font-size:11px}
@keyframes vs-run{from{left:0}to{left:calc(100% - 18px)}}
.vs-wpbox,.vs-rpbox{padding:22px 20px 50px}
.vs-box-lbl{font-size:13px}
.vs-wpbox i,.vs-rpbox i{font-size:12.5px;padding:6px 0}
.vs-conveyor i{font-size:14px;padding:10px 20px}
.vs-rambar{height:52px}
.vs-rambar .seg{font-size:13px;padding:0 18px}
.vs-beat{position:absolute;inset:0;padding:44px 40px 60px;display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateY(16px);transition:opacity .5s,transform .5s}
.vs-beat.on{opacity:1;transform:none}
.vs-cap{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:#ff6a00;text-align:center;margin-bottom:34px}
.vs-dots{position:absolute;bottom:22px;left:0;right:0;display:flex;gap:8px;justify-content:center}
.vs-dots .d{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.18);transition:background .3s,transform .3s}
.vs-dots .d.on{background:#ff6a00;transform:scale(1.3)}
