<script>
(function(){
  const frame = document.querySelector('.pr-anim');
  if (!frame) return;
  const scenes = Array.from(frame.querySelectorAll('.a-scene'));
  const dots   = Array.from(frame.querySelectorAll('.a-dots .d'));
  const cmd    = 'rpress migrate dump.sql --site-url https://example.com';
  const typeEl = frame.querySelector('.cmd-type');
  const outs   = frame.querySelectorAll('.a-term .o');
  let i = 0, timer = null, typeTimer = null;

  function typeCmd(k=0){
    typeEl.textContent = cmd.slice(0,k);
    outs.forEach(o=>o.classList.remove('show'));
    if (k < cmd.length) typeTimer = setTimeout(()=>typeCmd(k+1), 26);
    else {
      outs.forEach((o,idx)=>setTimeout(()=>o.classList.add('show'), 400+idx*420));
    }
  }
  function show(n){
    scenes.forEach((s,j)=>s.classList.toggle('on', j===n));
    dots.forEach((d,j)=>d.classList.toggle('on', j===n));
    if (n===0) typeCmd();
  }
  function next(){ i=(i+1)%scenes.length; show(i); timer=setTimeout(next, i===0?5200:4200); }
  dots.forEach((d,j)=>d.parentElement.addEventListener('click',e=>{e.preventDefault();i=j;clearTimeout(timer);clearTimeout(typeTimer);show(i);timer=setTimeout(next,4200)}));
  show(0);
  timer=setTimeout(next,5200);
})();
</script>
<script>
(function(){
  const how = document.getElementById('pr-how');
  if (!how) return;
  const order = ['p1','e1','p2','e2','p3','s1','e3','s2','e4','s3'];
  const els = Object.fromEntries(order.map(k=>[k, how.querySelector('[data-k="'+k+'"]')]));
  const wp = how.querySelector('.h-wp');
  const cells = how.querySelectorAll('.h-cell');
  let done = false;
  function run(){
    if (done) return; done = true;
    order.forEach((k,i)=>{
      setTimeout(()=>{
        const el = els[k];
        el.classList.add('on');
        if (k.startsWith('p') || k==='s3') { el.classList.add('lit'); setTimeout(()=>el.classList.remove('lit'), 900); }
      }, 300 + i*330);
    });
    setTimeout(()=>wp.classList.add('on'), 300 + order.length*330);
    cells.forEach((c,i)=>setTimeout(()=>c.classList.add('on'), 300 + order.length*330 + 500 + i*200));
    const base = 300 + order.length*330 + 1400;
    how.querySelectorAll('.h-arch-row').forEach((r,i)=>setTimeout(()=>r.classList.add('on'), base + i*260));
    setTimeout(()=>how.querySelector('.h-atk-note').classList.add('on'), base + 6*260 + 300);
  }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((es,ob)=>{ if (es[0].isIntersecting){ run(); ob.disconnect(); } },{threshold:.3}).observe(how);
  } else run();
})();
</script>
<script>
(function(){
  const stage = document.getElementById('vs-stage');
  if (!stage) return;
  const beats = Array.from(stage.querySelectorAll('.vs-beat'));
  const dots  = Array.from(stage.querySelectorAll('.vs-dots .d'));
  let i = 0, timer = null;
  let counted = false;
  function show(n){
    beats.forEach((b,j)=>b.classList.toggle('on', j===n));
    dots.forEach((d,j)=>d.classList.toggle('on', j===n));
    if (n===0 && !counted){
      counted = true;
      stage.querySelectorAll('.vs-num').forEach(el=>{
        const target = +el.dataset.n, suf = el.dataset.suf||'', pre = el.dataset.pre||'';
        const t0 = performance.now(), dur = 1100;
        (function tick(t){
          const p = Math.min(1,(t-t0)/dur), e = 1-Math.pow(1-p,3);
          el.textContent = pre + Math.round(target*e).toLocaleString('en-US') + suf;
          if (p<1) requestAnimationFrame(tick);
        })(t0);
      });
    }
  }
  function next(){ i=(i+1)%beats.length; show(i); timer=setTimeout(next,4600); }
  show(0);
  timer=setTimeout(next,4600);
  dots.forEach((d,j)=>d.addEventListener('click',()=>{i=j;clearTimeout(timer);show(i);timer=setTimeout(next,4600)}));
})();
</script>
