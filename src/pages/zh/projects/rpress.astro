---
import Base from '../../../layouts/Base.astro';
import { t as i18n } from '../../../data/apps.js';
import { projects } from '../../../data/projects.js';
const lang = 'zh';
const t = i18n[lang];
const p = projects.find(x => x.id === 'rpress');
---

<Base lang={lang} i18n={t} title="RPress — WordPress-parity CMS in one Rust binary">

<style>
.pr-hero{position:relative;padding:96px 0 72px;text-align:center;overflow:hidden}
.pr-hero::before{content:"";position:absolute;inset:-40% -10% auto;height:520px;
  background:radial-gradient(closest-side,rgba(255,106,0,.16),transparent 70%);pointer-events:none}
.pr-kicker{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1px solid var(--border);
  border-radius:999px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);background:var(--bg2)}
.pr-kicker b{color:#ff6a00;font-weight:600}
.pr-hero h1{font-size:clamp(48px,7vw,88px);font-weight:800;letter-spacing:-.045em;line-height:.95;margin:26px 0 14px;
  background:linear-gradient(180deg,#fff 30%,rgba(255,255,255,.55));-webkit-background-clip:text;background-clip:text;color:transparent}
.pr-hero .lede{max-width:640px;margin:0 auto;color:var(--muted);font-size:clamp(16px,1.8vw,19px);line-height:1.55}
.pr-cta{display:flex;gap:12px;justify-content:center;margin-top:32px;flex-wrap:wrap}
.pr-btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:10px;font-weight:600;font-size:15px;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease}
.pr-btn:hover{transform:translateY(-1px)}
.pr-btn--primary{background:#ff6a00;color:#0b0b0f;box-shadow:0 10px 30px rgba(255,106,0,.25)}
.pr-btn--ghost{border:1px solid var(--border);color:var(--fg);background:transparent}
.pr-meta{display:flex;flex-wrap:wrap;gap:0;justify-content:center;margin-top:44px}
.pr-meta .m{padding:12px 26px;border-right:1px solid var(--border);text-align:left}
.pr-meta .m:last-child{border-right:0}
.pr-meta .m span{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.pr-meta .m b{font-size:15px}

.pr-term{max-width:760px;margin:56px auto 0;border:1px solid var(--border);border-radius:14px;background:#0d0f14;
  box-shadow:0 30px 80px rgba(0,0,0,.45);overflow:hidden;text-align:left}
.pr-term-bar{display:flex;gap:6px;padding:12px 14px;border-bottom:1px solid var(--border)}
.pr-term-bar i{width:10px;height:10px;border-radius:50%;background:#3a3f4a}
.pr-term-bar i:nth-child(1){background:#ff5f57}.pr-term-bar i:nth-child(2){background:#febc2e}.pr-term-bar i:nth-child(3){background:#28c840}
.pr-term pre{margin:0;padding:20px 22px;font-size:13px;line-height:1.7;color:#c9d1d9;overflow:auto}
.pr-term .c{color:#6a737d}.pr-term .g{color:#7ee787}.pr-term .o{color:#ffa657}.pr-term .p{color:#79c0ff}

.pr-sec{padding:56px 0;border-top:1px solid var(--border)}
.pr-sec--who{border-top:0;padding-top:32px}
.pr-sec h2{font-size:clamp(26px,3.4vw,36px);font-weight:800;letter-spacing:-.03em;text-align:center;margin:0 0 12px}
.pr-sec .sub{text-align:center;color:var(--muted);max-width:620px;margin:0 auto 44px;font-size:16px}

.pr-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;max-width:1080px;margin:0 auto}
.pr-card{border:1px solid var(--border);border-radius:14px;padding:24px;background:var(--bg2);transition:border-color .2s,transform .2s}
.pr-card:hover{border-color:#ff6a0066;transform:translateY(-2px)}
.pr-card .n{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#ff6a00;font-weight:700}
.pr-card b{display:block;font-size:17px;margin:8px 0 8px;letter-spacing:-.01em}
.pr-card p{margin:0;color:var(--muted);font-size:14px;line-height:1.6}
.pr-card code{background:rgba(255,255,255,.06);padding:1px 6px;border-radius:5px;font-size:12px}

.pr-tbl{max-width:920px;margin:0 auto;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--bg2)}
.pr-tbl .r{display:grid;grid-template-columns:1.1fr 1.2fr 1fr;gap:16px;padding:15px 22px;border-top:1px solid var(--border);font-size:14px;align-items:center}
.pr-tbl .r:first-child{border-top:0;background:rgba(255,255,255,.04);font-weight:700}
.pr-tbl .r>span:first-child{color:var(--muted);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.pr-tbl .r .ours{color:#7ee787;font-weight:600}
.pr-tbl .r .ours::before{content:"✓ ";color:#7ee787;font-weight:700}
.pr-tbl .r .ours--warn{color:#ffa657}
.pr-tbl .r .ours--warn::before{content:"◐ ";color:#ffa657}
.pr-tbl .r .bad{color:var(--muted)}
.pr-tbl .r .bad::before{content:"✗ ";color:#f85149;font-weight:700;opacity:.85}
.pr-tbl .r .bad--ok{color:var(--muted)}
.pr-tbl .r .bad--ok::before{content:"— ";color:var(--muted)}
.pr-tbl--4 .r{grid-template-columns:1fr 1.25fr 1.15fr 1.15fr;font-size:13px}

.pr-arch{max-width:820px;margin:0 auto;border:1px solid var(--border);border-radius:14px;background:#0d0f14;padding:26px}
.pr-arch pre{margin:0;font-size:13px;line-height:1.7;color:#c9d1d9;overflow:auto}

.pr-callout{max-width:820px;margin:44px auto 0;border-left:3px solid #ff6a00;background:var(--bg2);
  border-radius:0 12px 12px 0;padding:18px 22px;color:var(--muted);font-size:14px;line-height:1.65}
.pr-callout b{color:var(--fg)}

.pr-foot{padding:72px 0 96px;text-align:center}
.pr-foot .big{font-size:clamp(24px,3.4vw,34px);font-weight:800;letter-spacing:-.03em}
.pr-foot code{display:inline-block;margin-top:18px;background:#0d0f14;border:1px solid var(--border);
  border-radius:10px;padding:14px 22px;font-size:14px;color:#7ee787}
.pr-hero h1 .grad{background:linear-gradient(90deg,#ff6a00,#ffa657);-webkit-background-clip:text;background-clip:text;color:transparent}
</style>

<section class="pr-hero">
  <div class="container">
    <span class="pr-kicker"><b>◆</b> Open source · Rust · MIT</span>
    <h1>WordPress,<br><span class="grad">without WordPress.</span></h1>
    <p class="lede">RPress reproduces wp-admin pixel-for-workflow and serves the site as <b>static files</b>.
    One 14 MB binary replaces PHP + MySQL + plugins. Import a WP dump, keep your editors' habits,
    lose the attack surface.</p>
    <div class="pr-cta">
      <a class="pr-btn pr-btn--primary" href={p.repo} target="_blank" rel="noopener">★ Star on GitHub</a>
      <a class="pr-btn pr-btn--ghost" href="#migrate">RPress migrate dump.sql ↓</a>
    </div>
    <div class="pr-meta">
      <div class="m"><span>Binary</span><b>14 MB</b></div>
      <div class="m"><span>RAM</span><b>30 MB</b></div>
      <div class="m"><span>TTFB</span><b>&lt;5 ms</b></div>
      <div class="m"><span>Migrate</span><b>1 command</b></div>
      <div class="m"><span>License</span><b>MIT</b></div>
    </div>

    <div class="pr-term">
      <div class="pr-term-bar"><i></i><i></i><i></i></div>
      <pre><span class="c"># one command: WP dump → imported site + admin user + rendered cache</span>
<span class="g">$</span> rpress <span class="o">migrate</span> dump.sql --site-url https://example.com
  → imported  <span class="p">951 posts</span>, 49 pages, 3 menus, 9,622 media
  → admin user <span class="p">admin@example.com</span> · password <span class="p">••••••••••••</span> (printed once)
  → rendered <span class="p">1,239 pages</span> → cache/
<span class="g">$</span> rpress serve --bind 127.0.0.1:8000 --db site.db
  → <span class="p">listening</span> · admin at /admin</pre>
    </div>
  </div>
</section>

<section class="pr-sec pr-sec--who">
  <div class="container">
    <h2>Who it's for</h2>
    <p class="sub">Three different readers, same answer.</p>
    <div class="pr-grid">
      <div class="pr-card"><span class="n">For developers</span><b>Boring on purpose</b><p>One process. SQL lives in <code>src/db/sql/*.sql</code>, compile-time <code>include_str!</code>. Zero warnings, zero runtime deps, MIT. Read the whole serving path in one sitting.</p></div>
      <div class="pr-card"><span class="n">For site owners</span><b>Cut the bill, keep the habit</b><p>Admin is wp-admin parity — editors don't relearn anything. $5 VPS replaces the managed-WP line item; backups are a <code>.db</code> + <code>www/</code> folder.</p></div>
      <div class="pr-card"><span class="n">For the curious</span><b>WordPress minus PHP</b><p>What if you kept wp-admin but the site never executes code? That's the whole trick — render once at publish, read files forever after.</p></div>
    </div>
  </div>
</section>

<section class="pr-sec">
  <div class="container">
    <h2>Why RPress wins — the numbers</h2>
    <p class="sub">Not vibes. Every advantage below is structural, so it holds at any traffic level.</p>
    <div class="pr-grid">
      <div class="pr-card"><span class="n">Request cost</span><b>µs, not ms</b><p>Serve = <code>fs::read</code> of a file already in the OS page cache. No query, no template, no PHP boot — the same reason nginx static hosting is fast, except the cache is native.</p></div>
      <div class="pr-card"><span class="n">Throughput</span><b>Bounded by disk, not CPU</b><p>Static reads scale with page cache + network. The Rust process isn't in the hot path — kernel sends the file. 100× headroom vs a PHP request path on the same box.</p></div>
      <div class="pr-card"><span class="n">Publish cost</span><b>One page at a time</b><p>Saving a post renders exactly one file — ~50–200 ms — plus regenerating sitefx files. No full-site rebuild, no ISR queue, no "deploy in progress".</p></div>
      <div class="pr-card"><span class="n">DB size</span><b>SQLite doesn't blink</b><p>A 5k-post site is a ~500 MB <code>.db</code> — trivial for SQLite (petabyte-tested engine, WAL mode). The DB is queried only on misses/admin, never on cache hits.</p></div>
      <div class="pr-card"><span class="n">Build</span><b>Compile once, ~90 s cold</b><p><code>cargo build --release</code> — one 14 MB static binary, zero runtime deps. No npm install, no node_modules, no Docker layer soup.</p></div>
      <div class="pr-card"><span class="n">Retrieve</span><b>B-Tree, not B-trees of joins</b><p>Reads go through <code>src/db/sql/*.sql</code> — one file per statement, compile-time embedded, no ORM generating N+1 queries behind your back.</p></div>
    </div>
  </div>
</section>

<section class="pr-sec">
  <div class="container">
    <h2>What it is</h2>
    <p class="sub">A structural conversion of WordPress — same admin screens, static output.</p>
    <div class="pr-callout" style="margin-top:0">
      RPress reproduces wp-admin one-for-one — posts, pages, media, comments, users, menus, widgets,
      revisions, quick edit, bulk actions — but the public site is <b>pre-rendered HTML read from disk</b>.
      The CMS does the WordPress work <b>once at publish time</b> and then gets out of the way.
      No PHP, no per-request render, no plugin runtime.
    </div>
    <div class="pr-grid" style="margin-top:44px">
      <div class="pr-card"><span class="n">Serve</span><b>Static-first</b><p><code>GET /slug</code> → read <code>cache/slug/index.html</code>. Misses render once and write back atomically — the cache warms itself from traffic.</p></div>
      <div class="pr-card"><span class="n">Footprint</span><b>14 MB · 30 MB RSS</b><p>SQLite bundled, zero CGO, zero runtime deps. A $5 VPS runs a fleet of sites; the process idles between publishes.</p></div>
      <div class="pr-card"><span class="n">Security</span><b>Attack surface ≈ binary</b><p><code>/wp-admin</code> → 404. In-memory sessions, argon2, per-session CSRF, upload allowlist, nosniff, rate-limited intake.</p></div>
      <div class="pr-card"><span class="n">Admin</span><b>wp-admin parity</b><p>List views, row actions, Quick Edit, bulk edit, revisions diff, media library, menu builder, widget sidebars — same habits.</p></div>
      <div class="pr-card"><span class="n">SEO</span><b>Meta + llms.txt</b><p>Rank-Math-compatible title/description/OG/Twitter/JSON-LD, sitemap, RSS, robots.txt — plus <code>.md</code> mirrors for AI readers.</p></div>
      <div class="pr-card"><span class="n">UX</span><b>SPA-feel nav</b><p><code>nav.js</code> prefetches on hover and swaps the content node. Instant-feeling navigation with zero framework.</p></div>
    </div>
  </div>
</section>

<section class="pr-sec">
  <div class="container">
    <h2>RPress vs WordPress vs Next.js</h2>
    <p class="sub">Same outcome — a site. Different operating cost, attack surface, and admin experience.</p>
    <div class="pr-tbl pr-tbl--4">
      <div class="r"><span></span><span class="ours">RPress</span><span>WordPress</span><span>Next.js + headless CMS</span></div>
      <div class="r"><span>Public request</span><span class="ours">fs::read cached file</span><span class="bad">PHP boot + 50–200 queries</span><span class="bad">Static file or SSR per page</span></div>
      <div class="r"><span>Pieces</span><span class="ours">1 binary + 1 .db</span><span class="bad">PHP-FPM + MySQL + WP + plugins</span><span class="bad">Node + CMS + DB + build</span></div>
      <div class="r"><span>RAM</span><span class="ours">~30 MB</span><span class="bad">~500 MB+</span><span class="bad">Node + framework baseline</span></div>
      <div class="r"><span>Admin UI</span><span class="ours">Built-in wp-admin parity</span><span class="bad--ok">wp-admin</span><span class="bad">Separate SaaS or DIY</span></div>
      <div class="r"><span>Build step</span><span class="ours">Per-page, on publish/miss</span><span class="bad--ok">None</span><span class="bad">Full SSG or ISR runtime</span></div>
      <div class="r"><span>Attack surface</span><span class="ours">Rust binary only</span><span class="bad">wp-admin, xmlrpc, plugin CVEs</span><span class="bad">Node deps + CMS API keys</span></div>
      <div class="r"><span>Cache model</span><span class="ours">Native — cache/ IS the site</span><span class="bad">Plugin bolt-on, expires/desyncs</span><span class="bad">ISR / edge cache config</span></div>
      <div class="r"><span>Ops</span><span class="ours">scp binary; run</span><span class="bad">Patch PHP/WP/plugins forever</span><span class="bad">Docker, env vars, build cache, CDN wiring</span></div>
      <div class="r"><span>Plugin ecosystem</span><span class="ours--warn">Ports in src/ — gap is real</span><span class="bad--ok">60k+ plugins</span><span class="bad--ok">npm + CMS marketplace</span></div>
      <div class="r"><span>Dynamic public pages</span><span class="ours--warn">No — by design</span><span class="bad--ok">Yes</span><span class="bad--ok">Yes (SSR/edge)</span></div>
      <div class="r"><span>Migration</span><span class="ours">One command — imports WP dump</span><span class="bad">—</span><span class="bad">Rebuild content model + theme</span></div>
      <div class="r"><span>Best for</span><span class="ours">Content sites, blog fleets, lean ops</span><span class="bad">Stores, forums, membership</span><span class="bad">Apps that are mostly dynamic</span></div>
    </div>
    <div class="pr-callout">Content sites — posts, pages, galleries, comments, reviews — RPress wins on every row that matters. Store/forum/membership → keep WordPress. Mostly-an-app → Next.js fits better.</div>
  </div>
</section>

<section class="pr-sec">
  <div class="container">
    <h2>Architecture</h2>
    <p class="sub">Two paths, deliberately separated: write once at publish, read many at serve.</p>
    <div class="pr-arch">
<svg viewBox="0 0 860 430" xmlns="http://www.w3.org/2000/svg" font-family="ui-monospace,Menlo,monospace" font-size="12" style="width:100%;height:auto">
  <defs><marker id="ah" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="var(--muted)"/></marker></defs>
  <text x="20" y="24" fill="#ff6a00" font-size="11" letter-spacing="2">PUBLISH — once</text>
  <rect x="20" y="36" width="180" height="44" rx="10" fill="none" stroke="var(--border)"/>
  <text x="110" y="62" fill="var(--fg)" text-anchor="middle">admin save / migrate</text>
  <line x1="200" y1="58" x2="250" y2="58" stroke="var(--muted)" marker-end="url(#ah)"/>
  <rect x="250" y="36" width="160" height="44" rx="10" fill="none" stroke="var(--border)"/>
  <text x="330" y="62" fill="var(--fg)" text-anchor="middle">render_slug + minijinja</text>
  <line x1="410" y1="58" x2="460" y2="58" stroke="var(--muted)" marker-end="url(#ah)"/>
  <rect x="460" y="36" width="190" height="44" rx="10" fill="none" stroke="var(--border)"/>
  <text x="555" y="62" fill="var(--fg)" text-anchor="middle">atomic write → cache/</text>
  <text x="20" y="140" fill="#7ee787" font-size="11" letter-spacing="2">SERVE — per request</text>
  <rect x="20" y="152" width="160" height="44" rx="10" fill="none" stroke="var(--border)"/>
  <text x="100" y="178" fill="var(--fg)" text-anchor="middle">GET /slug</text>
  <line x1="180" y1="174" x2="230" y2="174" stroke="var(--muted)" marker-end="url(#ah)"/>
  <rect x="230" y="152" width="140" height="44" rx="10" fill="none" stroke="var(--border)"/>
  <text x="300" y="178" fill="var(--fg)" text-anchor="middle">public_page</text>
  <line x1="370" y1="165" x2="460" y2="140" stroke="var(--muted)" marker-end="url(#ah)"/>
  <rect x="460" y="112" width="200" height="44" rx="10" fill="var(--surface)" stroke="#7ee787"/>
  <text x="560" y="130" fill="#7ee787" text-anchor="middle" font-weight="600">hit</text>
  <text x="560" y="147" fill="var(--fg)" text-anchor="middle">fs::read → 200 (~µs)</text>
  <line x1="370" y1="185" x2="460" y2="215" stroke="var(--muted)" marker-end="url(#ah)"/>
  <rect x="460" y="192" width="200" height="44" rx="10" fill="var(--surface)" stroke="var(--border)"/>
  <text x="560" y="210" fill="var(--muted)" text-anchor="middle" font-weight="600">miss</text>
  <text x="560" y="227" fill="var(--fg)" text-anchor="middle">render → write-back → 200</text>
  <line x1="300" y1="196" x2="300" y2="260" stroke="var(--muted)" marker-end="url(#ah)"/>
  <rect x="230" y="260" width="180" height="40" rx="10" fill="none" stroke="var(--border)"/>
  <text x="320" y="284" fill="var(--fg)" text-anchor="middle">GET /slug.md → index.md</text>
  <text x="20" y="345" fill="var(--muted)" font-size="11" letter-spacing="2">ON DISK</text>
  <rect x="20" y="356" width="180" height="52" rx="10" fill="none" stroke="var(--border)"/>
  <text x="110" y="378" fill="var(--fg)" text-anchor="middle">site.db (SQLite)</text>
  <text x="110" y="396" fill="var(--muted)" text-anchor="middle" font-size="10">posts · terms · users · settings</text>
  <rect x="230" y="356" width="200" height="52" rx="10" fill="none" stroke="var(--border)"/>
  <text x="330" y="378" fill="var(--fg)" text-anchor="middle">cache/&lt;slug&gt;/index.html</text>
  <text x="330" y="396" fill="var(--muted)" text-anchor="middle" font-size="10">the served site — disposable</text>
  <rect x="460" y="356" width="200" height="52" rx="10" fill="none" stroke="var(--border)"/>
  <text x="560" y="378" fill="var(--fg)" text-anchor="middle">www/ uploads · nav.js · css</text>
  <text x="560" y="396" fill="var(--muted)" text-anchor="middle" font-size="10">persistent — back this up</text>
  <rect x="690" y="152" width="150" height="96" rx="10" fill="none" stroke="var(--border)" stroke-dasharray="4 4"/>
  <text x="765" y="174" fill="var(--muted)" text-anchor="middle">sitefx (on publish)</text>
  <text x="765" y="192" fill="var(--fg)" text-anchor="middle">sitemap.xml · feed</text>
  <text x="765" y="208" fill="var(--fg)" text-anchor="middle">robots.txt · llms.txt</text>
  <text x="765" y="224" fill="var(--fg)" text-anchor="middle">redirects.map</text>
</svg>
    </div>
    <div class="pr-callout"><b>The cache is the site.</b> nginx can front <code>cache/</code> directly — RPress is then only needed for admin and misses. Restarting or upgrading the binary never loses content: the DB is the source of truth, the cache rebuilds.</div>
    <p class="sub" style="margin-top:36px">Layered source: SQL lives in <code>src/db/sql/*.sql</code> (compile-time <code>include_str!</code>), admin handlers call <code>db::</code> only, render owns the publish path. One process, no service mesh.</p>
  </div>
</section>

<section class="pr-sec">
  <div class="container">
    <h2>How fast is the site, actually</h2>
    <p class="sub">A public request is a file read. Here's what that means on the timeline.</p>
    <div class="pr-arch">
<svg viewBox="0 0 860 300" xmlns="http://www.w3.org/2000/svg" font-family="ui-monospace,Menlo,monospace" font-size="12" style="width:100%;height:auto">
  <defs><marker id="ah2" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="var(--muted)"/></marker></defs>
  <text x="20" y="24" fill="var(--muted)" font-size="11" letter-spacing="2">REQUEST → FIRST BYTE</text>

  <!-- RPress timeline -->
  <text x="20" y="60" fill="#7ee787" font-weight="700">RPress</text>
  <rect x="20" y="72" width="70" height="26" rx="6" fill="none" stroke="#7ee787"/>
  <text x="55" y="89" fill="var(--fg)" text-anchor="middle" font-size="10">route</text>
  <rect x="90" y="72" width="120" height="26" rx="6" fill="none" stroke="#7ee787"/>
  <text x="150" y="89" fill="var(--fg)" text-anchor="middle" font-size="10">fs::read</text>
  <rect x="210" y="72" width="80" height="26" rx="6" fill="#7ee787" opacity=".18"/>
  <text x="250" y="89" fill="#7ee787" text-anchor="middle" font-size="10" font-weight="700">~µs–2 ms</text>
  <text x="20" y="122" fill="var(--muted)" font-size="10">TCP + kernel sendfile; total &lt;5 ms typical</text>

  <!-- WordPress timeline -->
  <text x="20" y="168" fill="#f85149" font-weight="700">WordPress</text>
  <rect x="20" y="180" width="60" height="26" rx="6" fill="none" stroke="var(--border)"/>
  <text x="50" y="197" fill="var(--fg)" text-anchor="middle" font-size="10">nginx</text>
  <rect x="80" y="180" width="80" height="26" rx="6" fill="none" stroke="var(--border)"/>
  <text x="120" y="197" fill="var(--fg)" text-anchor="middle" font-size="10">PHP-FPM</text>
  <rect x="160" y="180" width="90" height="26" rx="6" fill="none" stroke="var(--border)"/>
  <text x="205" y="197" fill="var(--fg)" text-anchor="middle" font-size="10">WP boot</text>
  <rect x="250" y="180" width="120" height="26" rx="6" fill="none" stroke="var(--border)"/>
  <text x="310" y="197" fill="var(--fg)" text-anchor="middle" font-size="10">plugins load</text>
  <rect x="370" y="180" width="130" height="26" rx="6" fill="none" stroke="var(--border)"/>
  <text x="435" y="197" fill="var(--fg)" text-anchor="middle" font-size="10">50–200 SQL</text>
  <rect x="500" y="180" width="90" height="26" rx="6" fill="none" stroke="var(--border)"/>
  <text x="545" y="197" fill="var(--fg)" text-anchor="middle" font-size="10">render tpl</text>
  <rect x="590" y="180" width="90" height="26" rx="6" fill="#f85149" opacity=".18"/>
  <text x="635" y="197" fill="#f85149" text-anchor="middle" font-size="10" font-weight="700">200–800 ms</text>
  <text x="20" y="230" fill="var(--muted)" font-size="10">before the first byte leaves</text>

  <!-- delta -->
  <line x1="700" y1="85" x2="700" y2="195" stroke="var(--border)" stroke-dasharray="3 3"/>
  <text x="712" y="145" fill="#ff6a00" font-size="11" font-weight="700">40–400× faster TTFB</text>
  <text x="712" y="160" fill="var(--muted)" font-size="10">structural, not tuned</text>
</svg>
    </div>
    <div class="pr-grid" style="margin-top:36px">
      <div class="pr-card"><span class="n">TTFB</span><b>&lt;5 ms typical</b><p>File is in OS page cache → kernel sends it without touching the process. PHP's ~300 ms median never appears.</p></div>
      <div class="pr-card"><span class="n">LCP</span><b>Near-instant</b><p>HTML is complete on first byte — no render-blocking PHP, no hydration waiting on JS. Largest Contentful Paint lands with the document.</p></div>
      <div class="pr-card"><span class="n">CLS</span><b>0 by design</b><p>No runtime layout injection — content is final HTML at serve time. Fonts and images are the only variables left.</p></div>
      <div class="pr-card"><span class="n">Perceived nav</span><b>Instant on hover</b><p><code>nav.js</code> speculation-rules prefetch warms the next page before the click; swap replaces the content node — feels like an SPA, costs like a file read.</p></div>
    </div>
    <div class="pr-callout"><b>The honest caveat:</b> LCP depends on your theme's CSS/JS weight as much as the server. RPress removes the server-side ceiling — theme weight is the next bottleneck, and it's fully in your control.</div>
  </div>
</section>

<section class="pr-sec">
  <div class="container">
    <h2>How small a VPS does it need</h2>
    <p class="sub">The whole point: it fits where WordPress can't.</p>
    <div class="pr-tbl">
      <div class="r"><span>VPS</span><span class="ours">RPress</span><span>WordPress</span></div>
      <div class="r"><span>512 MB</span><span class="ours">Several sites, headroom left</span><span class="bad">MySQL alone wants ~400 MB</span></div>
      <div class="r"><span>1 GB</span><span class="ours">Dozens of sites behind nginx</span><span class="bad">Tight — PHP workers + MySQL</span></div>
      <div class="r"><span>2 GB</span><span class="ours">Effectively a blog fleet</span><span class="bad">Comfortable single site</span></div>
    </div>
    <div class="pr-callout">RPress idles at ~30 MB and only does real work on cache-miss renders — the OS page cache serves the rest. <b>$5/mo is not a constraint; it's overkill.</b></div>
  </div>
</section>

<section class="pr-sec" id="migrate">
  <div class="container">
    <h2>Migrate in one command</h2>
    <p class="sub">Dump → imported DB → rendered cache → credentials printed once.</p>
    <div class="pr-term">
      <div class="pr-term-bar"><i></i><i></i><i></i></div>
      <pre><span class="c"># build once</span>
<span class="g">$</span> cargo build --release

<span class="c"># point at a WP SQL dump</span>
<span class="g">$</span> ./target/release/rpress migrate dump.sql \
      --db site.db --templates templates --out cache --www www \
      --site-url https://example.com

<span class="c"># serve — admin at /admin</span>
<span class="g">$</span> ./target/release/rpress serve --site default --db site.db \
      --templates templates --out cache --www www --bind 127.0.0.1:8000</pre>
    </div>
    <div class="pr-callout">The cache then warms itself from traffic — <b>cold start is not required</b>. Steps also exist separately (<code>import parse</code>, <code>import verify</code>, <code>generate</code>, <code>user add</code>) for partial reruns.</div>
  </div>
</section>

