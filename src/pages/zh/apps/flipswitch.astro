---
import Base from '../../../layouts/Base.astro';
import AppPage from '../../../components/AppPage.astro';
import { apps, t } from '../../../data/apps.js';
const app = apps.find((a) => a.id === 'flipswitch');
const T = t.zh;
---
<Base title={app.name + ' — Suite'} desc={app.tagline.zh} lang="zh" i18n={T}>
  <AppPage app={app} t={T} lang="zh" />
</Base>
