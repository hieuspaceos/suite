---
import Base from '../../../layouts/Base.astro';
import AppPage from '../../../components/AppPage.astro';
import { apps, t } from '../../../data/apps.js';
const app = apps.find((a) => a.id === 'clipspot');
const T = t.ko;
---
<Base title={app.name + ' — Suite'} desc={app.tagline.ko} lang="ko" i18n={T}>
  <AppPage app={app} t={T} lang="ko" />
</Base>
